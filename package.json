{
  "name": "academic-webmcp-bridge",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @academic/demo-portal dev",
    "dev:demo": "pnpm --filter @academic/demo-portal dev",
    "build": "pnpm -r build",
    "build:demo": "pnpm --filter @academic/demo-portal build",
    "build:extension": "pnpm --filter @academic/extension build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
